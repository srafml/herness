+def with_policy(cfg: HernessConfig, *, profile: str, approved: bool, egress: bool) -> HernessConfig:
+    """`cfg` with another profile, egress switch and chat approval (TH06-12 cases)."""
+    sec = cfg.security
+    egress_cfg = sec.egress.model_copy(
